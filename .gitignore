.venv/
*.egg-info/
build/
dist/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/
.DS_Store

# Structures are fetched from RCSB on demand by scripts/00_fetch_targets.py.
data/pdb/*.cif
data/pdb/*.pdb

# Boltz outputs and analysis products are regenerated by the pipeline.
results/
results_synthetic/

# Model weights are never committed; Boltz downloads them to ~/.boltz on first run.
*.ckpt
*.pt

# Local scratch and working notes.
scratch/
notes/
for_ben/

# Local variants of the Colab notebook, both generated by notebooks/_build_notebook.py.
# The long form is the same cells with the reasoning behind each step written out, kept as
# working notes. The saved-outputs form points RESULTS at one person's Drive folder so the
# analysis sections can be re-run without predicting again — useful to that account and
# misleading in anyone else's clone. Neither is shipped.
notebooks/colab_boltz_cdr_long.ipynb
notebooks/colab_boltz_cdr_savedOutputs.ipynb
