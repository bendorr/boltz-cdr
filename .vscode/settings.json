{
  // Use the project virtualenv for the Python extension, the terminal, and notebooks.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,

  // Run notebooks from the repository root so relative paths such as data/pdb resolve
  // the same way they do for the scripts.
  "jupyter.notebookFileRoot": "${workspaceFolder}",

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"],

  "[python]": { "editor.rulers": [100] },
  "files.exclude": { "**/__pycache__": true, "**/.pytest_cache": true }
}
